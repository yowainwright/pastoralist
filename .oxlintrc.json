{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "legibility",
      "specifier": "eslint-plugin-legibility"
    }
  ],
  "rules": {
    "no-restricted-properties": [
      "error",
      {
        "object": "Promise",
        "property": "all",
        "message": "Promise.all is not allowed. Use composable async work or Promise.allSettled."
      }
    ],
    "legibility/hoist-if-operators": [
      "error",
      {
        "max": 0
      }
    ],
    "legibility/max-expression-operators": [
      "error",
      {
        "max": 4
      }
    ],
    "legibility/no-complex-ternaries": [
      "error",
      {
        "max": 2
      }
    ],
    "legibility/no-computed-values": [
      "error",
      {
        "max": 1
      }
    ],
    "legibility/no-hidden-side-effects": "error",
    "legibility/no-quadratic-patterns": "error",
    "legibility/no-standalone-array-mutations": "error",
    "legibility/prefer-concat-object-assign": "error",
    "legibility/require-executable-shebang": [
      "error",
      {
        "files": ["src/index.ts", "src/cli/index.ts"]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "scripts/**/*.js",
        "app/src/**/*.ts",
        "app/src/**/*.tsx",
        "app/scripts/**/*.ts"
      ],
      "rules": {
        "require-await": "error"
      }
    },
    {
      "files": ["scripts/**/*.js", "scripts/**/*.ts"],
      "rules": {
        "legibility/hoist-if-operators": "off",
        "legibility/max-expression-operators": "off",
        "legibility/no-complex-ternaries": "off",
        "legibility/no-computed-values": "off",
        "legibility/no-hidden-side-effects": "off",
        "legibility/no-quadratic-patterns": "off",
        "legibility/no-standalone-array-mutations": "off",
        "legibility/prefer-concat-object-assign": "off",
        "legibility/require-executable-shebang": "off",
        "legibility/no-direct-node-bin-smoke": [
          "error",
          {
            "entryPatterns": [
              "dist/index.js",
              "dist/cli/index.js",
              "src/index.ts",
              "src/cli/index.ts",
              "app/*/index.js",
              "*/dist/index.js",
              "*/dist/cli/index.js"
            ]
          }
        ]
      }
    }
  ]
}
