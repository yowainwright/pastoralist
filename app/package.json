  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:client && pnpm run build:static",
    "build:client": "pnpm run generate:llms && tsc && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "build:static": "pnpm run build:ssr && pnpm run prerender",
    "generate:llms": "jiti ../scripts/build/generate-llms-docs.ts",
    "prerender": "jiti scripts/prerender.ts",
    "preview": "vite preview",
    "serve": "vite preview --port 5174",
    "test:unit": "node --import=../tests/unit/setup.ts --test"
  },
