{
  "name": "shepherd-workspace",
  "lockfileVersion": 3,
  "packages": {
    "": {
      "name": "shepherd-workspace",
      "workspaces": ["packages/*"]
    },
    "packages/api": {
      "name": "@shepherd/api",
      "dependencies": {
        "qs": "^6.10.0"
      }
    },
    "packages/worker": {
      "name": "@shepherd/worker",
      "dependencies": {
        "qs": "^6.11.0"
      }
    },
    "node_modules/@shepherd/api": {
      "resolved": "packages/api",
      "link": true
    },
    "node_modules/@shepherd/worker": {
      "resolved": "packages/worker",
      "link": true
    },
    "node_modules/qs": {
      "version": "6.11.2"
    }
  }
}
