FROM ghcr.io/astral-sh/uv:0.5.9 AS uv
FROM node:26-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019

RUN apk add --no-cache bash jq python3
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app
COPY dist/ ./pastoralist/
COPY package.json ./pastoralist/package.json
COPY tests/e2e/fixtures/uv/ ./fixtures/
COPY tests/e2e/scripts/test-python.sh ./test.sh

ENV NODE_ENV=test
ENV IS_DEBUGGING=false
ENV UV_PYTHON_DOWNLOADS=never

CMD ["bash", "/app/test.sh"]
