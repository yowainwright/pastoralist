FROM node:26-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019

RUN npm install --global pnpm@12.5.1

COPY dist/ /app/pastoralist/
COPY package.json /app/pastoralist/package.json
COPY tests/e2e/scripts/transitive-security.test.ts /app/scripts/transitive-security.test.ts

WORKDIR /app/fixture

COPY <<'JSON' package.json
{
  "name": "sveltekit-security-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "pastoralist": {
    "bestCase": {
      "enabled": true
    }
  },
  "devDependencies": {
    "@clerk/themes": "^2.4.57",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.66.4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^25.9.8",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "http-status-codes": "^2.3.0",
    "husky": "^9.1.7",
    "layerchart": "^2.5.0",
    "lint-staged": "^17.6.0",
    "luxon": "^3.7.2",
    "mode-watcher": "^1.1.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "paneforge": "^1.0.2",
    "playwright": "^1.63.0",
    "posthog-js": "^1.434.18",
    "posthog-node": "^5.54.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-clerk": "^1.2.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3"
  }
}
JSON

COPY <<'YAML' pnpm-workspace.yaml
packages: []
YAML

RUN pnpm install --ignore-scripts --no-frozen-lockfile

ENV PASTORALIST_E2E_CLI=/app/pastoralist/index.js
ENV PASTORALIST_E2E_FULL_PROFILE=/app/fixture

CMD ["node", "--test", "/app/scripts/transitive-security.test.ts"]
