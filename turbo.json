{
  "$schema": "https://turborepo.org/schema.json",
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build-dist": {
      "dependsOn": ["^build-dist"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["NODE_ENV"]
    },
    "lint": {
      "cache": true,
      "outputs": []
    },
    "lint:shell:check": {
      "inputs": [
        "scripts/**",
        "tests/benchmarks/**",
        "tests/e2e/scripts/**",
        "scripts/.shellcheck-legibilityrc",
        ".shellcheckrc",
        ".github/workflows/ci.yml"
      ],
      "env": ["SHELLCHECK_VERSION", "SHELLCHECK_LEGIBILITY_VERSION", "SHELL_LINT_PLATFORM"],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": []
    },
    "typecheck-src": {
      "inputs": ["src/**/*.ts"],
      "cache": true,
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
