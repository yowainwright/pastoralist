{
  "$schema": "https://turborepo.org/schema.json",
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build-dist": {
      "dependsOn": ["^build-dist"],
      "inputs": [
        "src/**",
        "scripts/build/**",
        "scripts/is-main.ts",
        "scripts/turbo.sh",
        "skills/**",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["NODE_ENV", "PASTORALIST_RUNTIME", "NODE_OPTIONS"]
    },
    "lint": {
      "cache": true,
      "outputs": []
    },
    "lint:js:check": {
      "env": ["PASTORALIST_RUNTIME", "NODE_OPTIONS"],
      "cache": true,
      "outputs": []
    },
    "lint:shell:check": {
      "inputs": [
        "scripts/**",
        "tests/benchmarks/**",
        "tests/e2e/scripts/**",
        "scripts/.shellcheck-legibilityrc",
        ".shellcheckrc",
        ".github/workflows/ci.yml"
      ],
      "env": [
        "SHELLCHECK_VERSION",
        "SHELLCHECK_LEGIBILITY_VERSION",
        "SHFMT_VERSION",
        "SHELL_LINT_PLATFORM"
      ],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": []
    },
    "typecheck-src": {
      "inputs": ["src/**", "tsconfig*.json", "scripts/turbo.sh"],
      "env": ["PASTORALIST_RUNTIME", "NODE_OPTIONS"],
      "cache": true,
      "outputs": []
    },
    "test:unit:run": {
      "env": ["PASTORALIST_RUNTIME", "CI", "NODE_ENV", "NODE_OPTIONS", "TZ"],
      "outputs": [],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test:integration:run": {
      "env": ["PASTORALIST_RUNTIME", "CI", "NODE_ENV", "NODE_OPTIONS", "TZ"],
      "outputs": [],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test:coverage:run": {
      "inputs": ["$TURBO_DEFAULT$", "tests/coverage/**"],
      "env": ["PASTORALIST_RUNTIME", "CI", "NODE_ENV", "NODE_OPTIONS", "TZ"],
      "outputs": ["coverage/**", "!coverage/tmp/**"],
      "outputLogs": "errors-only",
      "cache": true
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
